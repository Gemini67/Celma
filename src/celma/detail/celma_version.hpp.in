/// @file
/// Contains automatically generated version information.


#pragma once


namespace celma {


static constexpr int  MAJOR_VERSION   = @MAJORVERSION@;
static constexpr int  MINOR_VERSION   = @MINORVERSION@;
static constexpr int  RELEASE_VERSION = @RELEASE_VERSION@;
static constexpr int  PATCH_LEVEL     = @PATCHLEVEL@;


static const char* const  VersionString  = "@MAJORVERSION@.@MINORVERSION@.@RELEASE_VERSION@-@PATCHLEVEL@";


} // namespace celma


// =====  END OF celma_version.hpp  =====

